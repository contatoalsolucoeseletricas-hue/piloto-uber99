<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Piloto Uber / 99 v1.6"
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="DESLIGADO · MODO CALIBRAÇÃO"
            android:textColor="#FACC15"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- PAINEL DE DIAGNÓSTICO DE PERMISSÕES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status das Permissões (POCO / MIUI)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermAccessibilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🔴 Acessibilidade: DESATIVADA"
                android:textColor="#F87171"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPermOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🔴 Sobreposição (Overlay): BLOQUEADA"
                android:textColor="#F87171"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDiagnosticTts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🔊 Motor TTS: INICIALIZANDO"
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDiagnosticLastApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📱 Último app visto: Nenhum"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTogglePilot"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#16A34A"
            android:text="LIGAR PILOTO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- BOTÃO DE TESTE / SIMULAÇÃO IMEDIATA -->
        <Button
            android:id="@+id/btnSimulateTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2563EB"
            android:text="🧪 TESTAR VOZ + SIMULAR CORRIDA"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTestFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#4ADE80"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchCalibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Modo Calibração (1 dia sem aceitar)"
                android:textColor="#F8FAFC"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mínimo aceito (R$ por km total)"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRateMinus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:text="-0,10"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etMinRate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:text="1.40"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnRatePlus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:text="+0,10"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salvar Mínimo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchCityFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Filtro de Cidades (Destino)"
                android:textColor="#F8FAFC"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMarkAllCities"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Marcar Todas"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClearAllCities"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Desmarcar"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cityCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Placar do Dia"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aceitas: 0 | Recusadas: 0\nTotal do dia: R$ 0,00 | Média: R$ 0,00/km"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnResetStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Zerar Placar do Dia" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Permissões Obrigatórias (Ativar Uma Vez)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Ativar Acessibilidade (Piloto Uber/99)" />

        <Button
            android:id="@+id/btnPermOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="2. Permitir Sobrepor Outros Apps" />

        <Button
            android:id="@+id/btnPermBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="3. Bateria Sem Restrições / MIUI" />

        <TextView
            android:id="@+id/tvLogPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#020617"
            android:padding="10dp"
            android:text="Última leitura aparecerá aqui."
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
