<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Piloto Uber / 99"
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="DESLIGADO · MODO CALIBRAÇÃO"
            android:textColor="#FACC15"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTogglePilot"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#16A34A"
            android:text="LIGAR PILOTO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchCalibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Modo Calibração (1 dia sem aceitar)"
                android:textColor="#F8FAFC"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mínimo aceito (R$ por km total)"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRateMinus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:text="-0,10"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etMinRate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:text="1.40"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnRatePlus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:text="+0,10"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSaveRate"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="Salvar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchCityFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Filtrar só cidades marcadas abaixo"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMarkAllCities"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Marcar Todas"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClearAllCities"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Desmarcar Todas"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cityCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumo de Hoje (Local)"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aceitas: 0 | Recusadas: 0
Total do dia: R$ 0,00 | Média: R$ 0,00/km"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnResetStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Zerar Placar do Dia" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Permissões Obrigatórias (MIUI 14 / POCO)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Ativar Acessibilidade" />

        <Button
            android:id="@+id/btnPermOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="2. Permitir Sobrepor Outros Apps" />

        <Button
            android:id="@+id/btnPermBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="3. Bateria Sem Restrições / MIUI" />

        <TextView
            android:id="@+id/tvLogPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#020617"
            android:padding="10dp"
            android:text="Última leitura aparecerá aqui."
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
