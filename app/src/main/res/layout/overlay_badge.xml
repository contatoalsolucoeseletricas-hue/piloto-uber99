<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#EE0F172A"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Linha 1: Decisão Clara em Destaque + Horário -->
    <TextView
        android:id="@+id/tvOverlayDecision"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PILOTO ON · MONITORANDO"
        android:textColor="#FACC15"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Linha 2 (Grande e Rápida de Bater o Olho): R$/km e R$/h -->
    <TextView
        android:id="@+id/tvOverlayRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="R$ --/km · R$ --/h"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Linha 3 (Compacta): App + Valor + Km Total + Minutos -->
    <TextView
        android:id="@+id/tvOverlayDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Aguardando primeira oferta..."
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Linha 4: Total do Dia -->
    <TextView
        android:id="@+id/tvOverlayTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Total dia: R$ 0,00 (0)"
        android:textColor="#94A3B8"
        android:textSize="10sp" />
</LinearLayout>
